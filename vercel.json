{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/write-env-js.mjs docs/brochure",
  "outputDirectory": "docs/brochure",
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=300"
        }
      ]
    }
  ]
}
